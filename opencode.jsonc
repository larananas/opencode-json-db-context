{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tohru-db",
  "permissions": [
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "deny"},
    {"action": "read", "resource": "*.env.*", "effect": "deny"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "read", "resource": "*.pem", "effect": "deny"},
    {"action": "read", "resource": "*.key", "effect": "deny"},
    {"action": "read", "resource": "*credentials*", "effect": "deny"},
    {"action": "glob", "resource": "*", "effect": "allow"},
    {"action": "grep", "resource": "*", "effect": "allow"},
    {"action": "skill", "resource": "database-export", "effect": "allow"},
    {"action": "question", "resource": "*", "effect": "allow"},
    {"action": "edit", "resource": "*", "effect": "deny"},
    {"action": "shell", "resource": "*", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "deny"},
    {"action": "subagent", "resource": "*", "effect": "deny"},
    {"action": "tohru_db_*", "resource": "*", "effect": "allow"}
  ],
  "mcp": {
    "timeout": {"startup": 300000, "catalog": 30000, "execution": 7200000},
    "servers": {
      "tohru_db": {
        "type": "local",
        "command": ["python3", "scripts/run_mcp.py"],
        "cwd": ".",
        "codemode": false,
        "protocol": "legacy",
        "disabled": true
      }
    }
  }
}
